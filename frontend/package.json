{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build:client": "npm install --prefix ../packages/guestbook_client && npm run build --prefix ../packages/guestbook_client",
    "setup:https": "bash scripts/setup-https.sh",
    "dev": "next dev --experimental-https --experimental-https-key ./certificates/localhost-key.pem --experimental-https-cert ./certificates/localhost.pem",
    "prebuild": "npm run build:client",
    "build": "next build",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "@stellar/freighter-api": "^6.0.1",
    "@stellar/stellar-sdk": "^14.5.0",
    "guestbook_client": "file:../packages/guestbook_client",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
